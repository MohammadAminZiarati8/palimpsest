<Project Sdk="Microsoft.NET.Sdk">

  <!-- Engine-free game rules, used by server and Unity client (A1). Unity 6 = C# 9. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>Game.Shared</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- M0-6: every build copies the DLL and content/*.json into Unity (A1, A8). Never edit the copies.
       Only Game.Shared.dll is copied: Unity supplies Newtonsoft itself (com.unity.nuget.newtonsoft-json = 13.0.2). -->
  <PropertyGroup>
    <UnityAssets>$(MSBuildThisFileDirectory)..\client\Assets\</UnityAssets>
    <ContentSrc>$(MSBuildThisFileDirectory)..\content\</ContentSrc>
    <ContentDst>$(UnityAssets)_Game\Resources\Content\</ContentDst>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.2" />
  </ItemGroup>

  <Target Name="CopyToUnity" AfterTargets="Build" Condition="Exists('$(UnityAssets)')">
    <ItemGroup>
      <SharedOut Include="$(TargetDir)$(TargetName).dll;$(TargetDir)$(TargetName).pdb" />
      <ContentJson Include="$(ContentSrc)**\*.json" />
      <ContentCopy Include="@(ContentJson->'$(ContentDst)%(RecursiveDir)%(Filename)%(Extension)')" />
      <ContentOld Include="$(ContentDst)**\*.json" Exclude="@(ContentCopy)" />
    </ItemGroup>
    <Copy SourceFiles="@(SharedOut)" DestinationFolder="$(UnityAssets)Plugins\Shared" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(ContentJson)" DestinationFiles="@(ContentCopy)" SkipUnchangedFiles="true" />
    <Delete Files="@(ContentOld)" />
  </Target>

</Project>
